{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PRITIDIPADAS/nakshatra-chronus/blob/main/research_discovery/spherex/electron_calibration_record.schema.json",
  "title": "CHRONOS SPHEREx absolute-gain photon-noise calibration record",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "verification_status",
    "calibration_product",
    "calibration_bunit",
    "exposure_time_s",
    "science_file_sha256",
    "science_observation_id",
    "science_source_uri",
    "detector",
    "image_unit",
    "calibration_uri",
    "calibration_file_path",
    "calibration_sha256",
    "conversion_method",
    "verified_by",
    "verified_utc"
  ],
  "properties": {
    "verification_status": {
      "const": "verified"
    },
    "calibration_product": {
      "const": "abs_gain_matrix"
    },
    "calibration_bunit": {
      "type": "string",
      "minLength": 1
    },
    "exposure_time_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "science_file_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "science_native_file_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "science_cutout_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "science_observation_id": {
      "type": "string",
      "minLength": 1
    },
    "science_source_uri": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "detector": {
      "enum": [
        "D1",
        "D2",
        "D3",
        "D4",
        "D5",
        "D6"
      ]
    },
    "image_unit": {
      "const": "MJy/sr"
    },
    "calibration_uri": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "calibration_file_path": {
      "type": "string",
      "minLength": 1
    },
    "calibration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "conversion_method": {
      "type": "string",
      "minLength": 12
    },
    "verified_by": {
      "type": "string",
      "minLength": 1
    },
    "verified_utc": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "science_native_file_sha256"
        ]
      },
      "then": {
        "properties": {
          "science_native_file_sha256": {
            "const": {
              "$data": "1/science_file_sha256"
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "science_cutout_sha256"
        ]
      },
      "then": {
        "properties": {
          "science_cutout_sha256": {
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  ],
  "$comment": "science_file_sha256 identifies the native MEF. GUI cutout injection additionally requires science_cutout_sha256. A reviewer must verify the conversion derivation and calibration bytes; schema validation is not scientific sign-off."
}